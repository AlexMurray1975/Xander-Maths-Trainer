# Copy these into Vercel: Project Settings, Environment Variables.

# Your Anthropic API key, from console.anthropic.com.
ANTHROPIC_API_KEY=

# The model the extractor should use. Pin it here rather than in the code, so
# that moving to a different model is a settings change and not a deployment.
ANTHROPIC_MODEL=

# A shared secret of your own choosing, any long random string. The app asks
# for it once and keeps it on the device. Without it the extraction endpoint
# is an open proxy to your API key for anyone who finds the URL.
APP_TOKEN=

# The domain school mail must come from. Anything else is discarded unread.
SCHOOL_DOMAIN=norlandplace.com
